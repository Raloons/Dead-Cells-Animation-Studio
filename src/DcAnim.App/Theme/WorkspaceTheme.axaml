<!-- Neutral workspace design tokens: charcoal/graphite, restrained gray
     selection, one muted functional amber reserved for the hit marker. -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Surfaces -->
  <Color x:Key="WsAppBackground">#111114</Color>
  <Color x:Key="WsPanelBackground">#17171B</Color>
  <Color x:Key="WsPanelAltBackground">#101014</Color>
  <Color x:Key="WsTrackBackground">#141417</Color>
  <Color x:Key="WsControlBackground">#202025</Color>
  <Color x:Key="WsHoverBackground">#26262C</Color>
  <Color x:Key="WsSelectedBackground">#2E2E36</Color>
  <Color x:Key="WsSelectedBorder">#6E6E78</Color>

  <!-- Borders -->
  <Color x:Key="WsBorder">#242429</Color>
  <Color x:Key="WsBorderStrong">#35353C</Color>
  <Color x:Key="WsSeparator">#222227</Color>

  <!-- Text -->
  <Color x:Key="WsTextPrimary">#E8E8EC</Color>
  <Color x:Key="WsTextSecondary">#A9A9B3</Color>
  <Color x:Key="WsTextMuted">#76767F</Color>

  <!-- Functional marker (hit frame only) -->
  <Color x:Key="WsHit">#C9973F</Color>
  <Color x:Key="WsPlayhead">#E8E8EC</Color>

  <!-- Metrics -->
  <CornerRadius x:Key="WsCornerSmall">3</CornerRadius>
  <CornerRadius x:Key="WsCornerMedium">4</CornerRadius>
  <x:Double x:Key="WsPanelPadding">10</x:Double>
  <x:Double x:Key="WsHeaderFontSize">11</x:Double>
  <x:Double x:Key="WsBodyFontSize">12</x:Double>
  <x:Double x:Key="WsValueFontSize">13</x:Double>
  <x:Double x:Key="WsTransportButtonSize">34</x:Double>
  <x:Double x:Key="WsIconSize">16</x:Double>
</ResourceDictionary>
