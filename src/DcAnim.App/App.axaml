<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DcAnim.App.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://DeadCells.AnimationStudio/Theme/WorkspaceTheme.axaml"/>
        <ResourceInclude Source="avares://DeadCells.AnimationStudio/Resources/Icons.axaml"/>
      </ResourceDictionary.MergedDictionaries>
      <!-- Neutral gray accent: Fluent controls (checkbox, slider, focus,
           selection) stay functional without a color identity. -->
      <Color x:Key="SystemAccentColor">#8E8E96</Color>
      <Color x:Key="SystemAccentColorLight1">#A6A6B0</Color>
      <Color x:Key="SystemAccentColorLight2">#BCBCC4</Color>
      <Color x:Key="SystemAccentColorLight3">#D2D2D8</Color>
      <Color x:Key="SystemAccentColorDark1">#77777F</Color>
      <Color x:Key="SystemAccentColorDark2">#62626A</Color>
      <Color x:Key="SystemAccentColorDark3">#4E4E55</Color>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://DeadCells.AnimationStudio/Theme/WorkspaceStyles.axaml"/>
  </Application.Styles></Application>
