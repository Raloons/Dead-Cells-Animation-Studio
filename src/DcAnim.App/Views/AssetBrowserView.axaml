<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DcAnim.App.Views.AssetBrowserView">
  <DockPanel>
    <!-- Search -->
    <TextBox DockPanel.Dock="Top" x:Name="SearchBox"
             Watermark="Search animations…  (Ctrl+F)"
             Margin="0,0,0,8"
             ToolTip.Tip="Filter by animation ID (Ctrl+F)"/>

    <!-- Category pills -->
    <WrapPanel DockPanel.Dock="Top" x:Name="CategoryPanel" Margin="0,0,0,8"/>

    <!-- List header: count + view toggle -->
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4">
        <ToggleButton x:Name="ListViewButton" Classes="ws-tool" IsChecked="True"
                      ToolTip.Tip="List view">
          <Path Data="{StaticResource IconList}" Fill="{StaticResource WsTextSecondary}"
                Width="16" Height="16" Stretch="Uniform"/>
        </ToggleButton>
        <ToggleButton x:Name="GridViewButton" Classes="ws-tool"
                      ToolTip.Tip="Grid view">
          <Path Data="{StaticResource IconGrid}" Fill="{StaticResource WsTextSecondary}"
                Width="16" Height="16" Stretch="Uniform"/>
        </ToggleButton>
      </StackPanel>
      <TextBlock x:Name="CountText" Classes="ws-panel-header" Text="—" Margin="0,6,0,0"/>
    </DockPanel>

    <TextBlock DockPanel.Dock="Bottom" x:Name="StatusText" FontSize="11"
               Foreground="{StaticResource WsTextMuted}" Margin="0,6,0,0" Text=""/>

    <Grid>
      <!-- List mode -->
      <ListBox x:Name="AnimationList" Background="Transparent" Padding="0"
             SelectionMode="Single"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Grid ColumnDefinitions="56,*,Auto" Margin="0,2">
            <Border Grid.Column="0" Width="52" Height="52" CornerRadius="4"
                    Background="#101016" BorderBrush="{StaticResource WsBorder}" BorderThickness="1">
              <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="2"
                     RenderOptions.BitmapInterpolationMode="None"/>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
              <TextBlock Text="{Binding Id}" FontSize="12" Foreground="{StaticResource WsTextPrimary}"/>
              <TextBlock Text="{Binding Meta}" FontSize="11" Foreground="{StaticResource WsTextMuted}"/>
            </StackPanel>
            <Border Grid.Column="2" VerticalAlignment="Center" Margin="6,0,2,0" Padding="6,2"
                    CornerRadius="8" Background="{StaticResource WsControlBackground}"
                    IsVisible="{Binding CategoryVisible}">
              <TextBlock Text="{Binding Category}" FontSize="10" Foreground="{StaticResource WsTextSecondary}"/>
            </Border>
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <!-- Grid mode (selection synced with list mode) -->
    <ListBox x:Name="AnimationGrid" IsVisible="False" Background="Transparent" Padding="0"
             SelectionMode="Single"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel Orientation="Horizontal"/>
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>
      <ListBox.ItemTemplate>
        <DataTemplate>
          <StackPanel Width="100" Margin="0,0,6,6">
            <Border Height="72" CornerRadius="4" Background="#101016"
                    BorderBrush="{StaticResource WsBorder}" BorderThickness="1">
              <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="3"
                     RenderOptions.BitmapInterpolationMode="None"/>
            </Border>
            <TextBlock Text="{Binding Id}" FontSize="10" Foreground="{StaticResource WsTextPrimary}"
                       TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" Margin="0,3,0,0"/>
            <TextBlock Text="{Binding FrameMeta}" FontSize="10" Foreground="{StaticResource WsTextMuted}"
                       HorizontalAlignment="Center"/>
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <!-- Empty / no-source state overlays the list area -->
    <TextBlock x:Name="EmptyText" IsVisible="False" TextWrapping="Wrap"
               Foreground="{StaticResource WsTextMuted}" FontSize="12" Margin="4,12,4,0"
               VerticalAlignment="Top"/>
    </Grid>
  </DockPanel>
</UserControl>
