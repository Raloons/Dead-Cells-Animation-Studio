<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DcAnim.App.Controls"
             x:Class="DcAnim.App.Views.TimelineView">
  <DockPanel>
    <!-- Timeline toolbar -->
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <TextBlock Text="Zoom" Classes="ws-prop-label" VerticalAlignment="Center"/>
        <Slider x:Name="ZoomSlider" Minimum="0.5" Maximum="8" Value="2" Width="110"
                VerticalAlignment="Center"
                ToolTip.Tip="Timeline zoom (pixels per frame)"/>
        <Button x:Name="FitButton" Classes="ws-tool" ToolTip.Tip="Fit track to view">
          <Path Data="{StaticResource IconFit}" Stroke="{StaticResource WsTextSecondary}"
                StrokeThickness="1.6" Width="14" Height="14" Stretch="Uniform"/>
        </Button>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <Path Data="{StaticResource IconFilm}" Fill="{StaticResource WsTextMuted}"
              Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
        <TextBlock Text="TIMELINE" Classes="ws-panel-header" Margin="0"/>
        <TextBlock x:Name="PositionText" FontSize="12" Foreground="{StaticResource WsTextPrimary}"
                   VerticalAlignment="Center" Text="—"/>
        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
          <Border Width="10" Height="10" Background="{StaticResource WsHit}" CornerRadius="2"/>
          <TextBlock Text="hit frame" FontSize="11" Foreground="{StaticResource WsTextMuted}"
                     VerticalAlignment="Center"/>
        </StackPanel>
      </StackPanel>
    </DockPanel>

    <!-- Scrollable track -->
    <Border BorderBrush="{StaticResource WsBorder}" BorderThickness="1" CornerRadius="6"
            Background="{StaticResource WsTrackBackground}">
      <ScrollViewer x:Name="TrackScroll" HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Disabled" Padding="0">
        <controls:TrackControl x:Name="Track" Height="106"/>
      </ScrollViewer>
    </Border>
  </DockPanel>
</UserControl>
