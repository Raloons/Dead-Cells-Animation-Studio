<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DcAnim.App.Controls"
        x:Class="DcAnim.App.MainWindow"
        Title="Dead Cells Animation Studio"
        Width="1280" Height="800" MinWidth="960" MinHeight="600">
  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem x:Name="OpenPakItem" Header="Open res.pak…"/>
        <MenuItem x:Name="OpenAtlasItem" Header="Open extracted atlas folder…"/>
        <Separator/>
        <MenuItem x:Name="ReloadItem" Header="Reload"/>
        <Separator/>
        <MenuItem x:Name="ExitItem" Header="Exit"/>
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem x:Name="AboutItem" Header="About"/>
      </MenuItem>
    </Menu>

    <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="#2A2A35" Background="#17171D" Padding="8,4">
      <TextBlock x:Name="StatusText" Text="Starting…" FontSize="12" Foreground="#9C9CA8"/>
    </Border>

    <Grid ColumnDefinitions="264,*,300" RowDefinitions="*,150">
      <!-- Left: asset browser -->
      <Border Grid.Row="0" Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="#2A2A35" Background="#1B1B22">
        <DockPanel Margin="8">
          <TextBlock DockPanel.Dock="Top" Text="ASSET BROWSER" FontSize="11" Foreground="#8B8B98" Margin="0,0,0,6"/>
          <TextBox DockPanel.Dock="Top" x:Name="SearchBox" Watermark="Search animation ID…" Margin="0,0,0,6"/>
          <TextBlock DockPanel.Dock="Top" x:Name="CatalogCount" Text="" FontSize="11" Foreground="#8B8B98" Margin="0,0,0,6"/>
          <ListBox x:Name="AnimationList" Background="#141419"/>
        </DockPanel>
      </Border>

      <!-- Center: preview + transport -->
      <DockPanel Grid.Row="0" Grid.Column="1" Background="#101016">
        <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="#2A2A35" Background="#17171D" Padding="8">
          <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button x:Name="RestartButton" Content="⏮" Width="40" ToolTip.Tip="Restart"/>
            <Button x:Name="PrevButton" Content="◀" Width="40" ToolTip.Tip="Previous frame"/>
            <Button x:Name="PlayButton" Content="▶" Width="56" ToolTip.Tip="Play / pause"/>
            <Button x:Name="NextButton" Content="▶|" Width="40" ToolTip.Tip="Next frame"/>
            <CheckBox x:Name="LoopCheck" Content="Loop" IsChecked="True" VerticalAlignment="Center" Margin="8,0,0,0"/>
            <TextBlock Text="Speed" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#9C9CA8"/>
            <ComboBox x:Name="SpeedBox" Width="76" SelectedIndex="2">
              <ComboBoxItem Content="0.25x" Tag="0.25"/>
              <ComboBoxItem Content="0.5x" Tag="0.5"/>
              <ComboBoxItem Content="1x" Tag="1"/>
              <ComboBoxItem Content="2x" Tag="2"/>
              <ComboBoxItem Content="4x" Tag="4"/>
            </ComboBox>
            <TextBlock Text="FPS" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#9C9CA8"/>
            <ComboBox x:Name="FpsBox" Width="70" SelectedIndex="3">
              <ComboBoxItem Content="12" Tag="12"/>
              <ComboBoxItem Content="15" Tag="15"/>
              <ComboBoxItem Content="24" Tag="24"/>
              <ComboBoxItem Content="30" Tag="30"/>
              <ComboBoxItem Content="60" Tag="60"/>
            </ComboBox>
            <TextBlock Text="Zoom" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="#9C9CA8"/>
            <Slider x:Name="ZoomSlider" Minimum="1" Maximum="8" Value="3" Width="110" VerticalAlignment="Center"/>
          </StackPanel>
        </Border>
        <controls:PreviewControl x:Name="Preview" Margin="8"/>
      </DockPanel>

      <!-- Right: inspector -->
      <Border Grid.Row="0" Grid.Column="2" BorderThickness="1,0,0,0" BorderBrush="#2A2A35" Background="#1B1B22">
        <ScrollViewer>
          <StackPanel Margin="10" Spacing="4">
            <TextBlock Text="INSPECTOR" FontSize="11" Foreground="#8B8B98" Margin="0,0,0,4"/>
            <TextBlock Text="Animation ID" FontSize="11" Foreground="#8B8B98"/>
            <TextBlock x:Name="InspId" Text="—" FontSize="14"/>
            <TextBlock Text="Frames" FontSize="11" Foreground="#8B8B98" Margin="0,6,0,0"/>
            <TextBlock x:Name="InspFrames" Text="—" FontSize="14"/>
            <TextBlock Text="Duration (s)" FontSize="11" Foreground="#8B8B98" Margin="0,6,0,0"/>
            <TextBlock x:Name="InspDuration" Text="—" FontSize="14"/>
            <TextBlock Text="Current frame" FontSize="11" Foreground="#8B8B98" Margin="0,6,0,0"/>
            <TextBlock x:Name="InspCurrent" Text="—" FontSize="14"/>
            <TextBlock Text="Hit frame" FontSize="11" Foreground="#8B8B98" Margin="0,6,0,0"/>
            <TextBlock x:Name="InspHit" Text="—" FontSize="14"/>
            <TextBlock Text="Charge (s)" FontSize="11" Foreground="#8B8B98" Margin="0,6,0,0"/>
            <TextBlock x:Name="InspCharge" Text="—" FontSize="14"/>
            <TextBlock Text="FX ID" FontSize="11" Foreground="#8B8B98" Margin="0,6,0,0"/>
            <TextBlock x:Name="InspFx" Text="—" FontSize="14"/>
            <TextBlock Text="Timing source" FontSize="11" Foreground="#8B8B98" Margin="0,6,0,0"/>
            <TextBlock x:Name="InspTimingSrc" Text="—" FontSize="12" TextWrapping="Wrap"/>
            <TextBlock Text="Source asset" FontSize="11" Foreground="#8B8B98" Margin="0,6,0,0"/>
            <TextBlock x:Name="InspSource" Text="—" FontSize="12" TextWrapping="Wrap"/>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- Bottom: timeline -->
      <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" BorderThickness="0,1,0,0" BorderBrush="#2A2A35" Background="#14141A" Padding="10,6">
        <DockPanel>
          <StackPanel DockPanel.Dock="Left" Width="170" Spacing="2" VerticalAlignment="Center">
            <TextBlock Text="TIMELINE" FontSize="11" Foreground="#8B8B98"/>
            <TextBlock x:Name="TimelineLabel" Text="—" FontSize="12" Foreground="#CFCFDA"/>
            <TextBlock Text="Click / drag to scrub" FontSize="11" Foreground="#71717E"/>
          </StackPanel>
          <controls:TimelineControl x:Name="Timeline" Margin="8,0,0,0"/>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
