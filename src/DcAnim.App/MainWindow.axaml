<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:DcAnim.App.Views"
        x:Class="DcAnim.App.MainWindow"
        Title="Dead Cells Animation Studio"
        Width="1400" Height="880" MinWidth="1024" MinHeight="640">

  <DockPanel Background="{StaticResource WsAppBackground}">
    <!-- Top application bar -->
    <Border DockPanel.Dock="Top" Background="{StaticResource WsPanelBackground}"
            BorderBrush="{StaticResource WsBorder}" BorderThickness="0,0,0,1">
      <DockPanel Margin="10,4">
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <TextBlock Text="Dead Cells Animation Studio" FontSize="13" FontWeight="SemiBold"
                     Foreground="{StaticResource WsTextPrimary}" VerticalAlignment="Center"/>
          <Menu VerticalAlignment="Center">
            <MenuItem Header="_File">
              <MenuItem x:Name="OpenPakItem" Header="Open game res.pak…"/>
              <MenuItem x:Name="OpenAtlasItem" Header="Open extracted atlas folder…"/>
              <Separator/>
              <MenuItem x:Name="NewProjectItem" Header="New project" InputGesture="Ctrl+N"/>
              <MenuItem x:Name="OpenProjectItem" Header="Open project…" InputGesture="Ctrl+O"/>
              <MenuItem x:Name="SaveItem" Header="Save project" InputGesture="Ctrl+S"/>
              <MenuItem x:Name="SaveAsItem" Header="Save project as…" InputGesture="Ctrl+Shift+S"/>
              <MenuItem Header="Export sequence">
                <MenuItem x:Name="ExportPngItem" Header="PNG frame sequence…"/>
                <MenuItem x:Name="ExportGifItem" Header="Animated GIF…"/>
                <MenuItem x:Name="ExportSheetItem" Header="Sprite sheet…"/>
              </MenuItem>
              <Separator/>
              <MenuItem x:Name="ReloadItem" Header="Reload game source" InputGesture="F5"/>
              <Separator/>
              <MenuItem x:Name="ExitItem" Header="Exit" InputGesture="Alt+F4"/>
            </MenuItem>
            <MenuItem Header="_Edit">
              <MenuItem x:Name="PlayPauseItem" Header="Play / pause" InputGesture="Space"/>
              <MenuItem x:Name="PrevFrameItem" Header="Previous frame" InputGesture="Left"/>
              <MenuItem x:Name="NextFrameItem" Header="Next frame" InputGesture="Right"/>
              <MenuItem x:Name="FirstFrameItem" Header="First frame" InputGesture="Home"/>
              <MenuItem x:Name="LastFrameItem" Header="Last frame" InputGesture="End"/>
            </MenuItem>
            <MenuItem Header="_View">
              <MenuItem x:Name="CheckerItem" Header="Checkerboard background" InputGesture="Ctrl+B"
                        ToggleType="CheckBox" IsChecked="True"/>
              <MenuItem x:Name="FitItem" Header="Fit preview to view" InputGesture="Ctrl+0"/>
              <MenuItem x:Name="TimelineZoomInItem" Header="Timeline zoom in"/>
              <MenuItem x:Name="TimelineZoomOutItem" Header="Timeline zoom out"/>
              <Separator/>
              <MenuItem x:Name="ResetLayoutItem" Header="Reset workspace layout"/>
            </MenuItem>
            <MenuItem Header="_Help">
              <MenuItem x:Name="ShortcutsItem" Header="Keyboard shortcuts"/>
              <MenuItem x:Name="FormatNotesItem" Header="Native format notes"/>
              <MenuItem x:Name="AboutItem" Header="About"/>
            </MenuItem>
          </Menu>
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
          <TextBlock x:Name="SourceText" FontSize="11" Foreground="{StaticResource WsTextMuted}"
                     VerticalAlignment="Center" Text="No source" Margin="0,0,8,0"/>
          <ToggleButton x:Name="ViewerModeButton" Classes="ws-tool" Content="Viewer" IsChecked="True"
                        ToolTip.Tip="Inspect a single native animation"/>
          <ToggleButton x:Name="SequenceModeButton" Classes="ws-tool" Content="Sequence"
                        ToolTip.Tip="Edit a multi-clip sequence project"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Workspace -->
    <Grid RowDefinitions="*,5,Auto">
      <Grid Grid.Row="0" x:Name="MainGrid">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="300" MinWidth="200" MaxWidth="560"/>
          <ColumnDefinition Width="5"/>
          <ColumnDefinition Width="*" MinWidth="300"/>
          <ColumnDefinition Width="5"/>
          <ColumnDefinition Width="300" MinWidth="220" MaxWidth="560"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{StaticResource WsPanelBackground}"
                BorderBrush="{StaticResource WsBorder}" BorderThickness="0,0,1,0" Padding="10">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="LIBRARY" Classes="ws-panel-header"/>
            <views:AssetBrowserView x:Name="Browser"/>
          </DockPanel>
        </Border>

        <GridSplitter Grid.Column="1" Width="5" VerticalAlignment="Stretch"
                      HorizontalAlignment="Center" Background="Transparent"
                      ResizeBehavior="PreviousAndNext"/>

        <Grid Grid.Column="2" Margin="12,10,12,8">
          <DockPanel>
            <Border DockPanel.Dock="Bottom" Background="{StaticResource WsPanelBackground}"
                    BorderBrush="{StaticResource WsBorder}" BorderThickness="1" CornerRadius="4"
                    Padding="8,6" Margin="0,8,0,0" HorizontalAlignment="Center">
              <views:TransportControl x:Name="Transport"/>
            </Border>
            <views:AnimationViewportView x:Name="Viewport"/>
          </DockPanel>
          <!-- Transient notification: loading errors only, auto-dismisses -->
          <Border x:Name="Toast" IsVisible="False"
                  HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12,0,0"
                  MaxWidth="560" Background="{StaticResource WsControlBackground}"
                  BorderBrush="{StaticResource WsSelectedBorder}" BorderThickness="1"
                  CornerRadius="4" Padding="10,8">
            <TextBlock x:Name="ToastText" FontSize="12" Foreground="{StaticResource WsTextPrimary}"
                       TextWrapping="Wrap"/>
          </Border>
        </Grid>

        <GridSplitter Grid.Column="3" Width="5" VerticalAlignment="Stretch"
                      HorizontalAlignment="Center" Background="Transparent"
                      ResizeBehavior="PreviousAndNext"/>

        <Border Grid.Column="4" Background="{StaticResource WsPanelBackground}"
                BorderBrush="{StaticResource WsBorder}" BorderThickness="1,0,0,0" Padding="10">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="INSPECTOR" Classes="ws-panel-header"/>
            <views:AnimationInspectorView x:Name="Inspector"/>
            <views:SequenceInspectorView x:Name="SeqInspector" IsVisible="False"/>
          </DockPanel>
        </Border>
      </Grid>

      <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch"
                    VerticalAlignment="Center" Background="Transparent"
                    ResizeBehavior="PreviousAndNext"/>

      <Border Grid.Row="2" x:Name="TimelinePanel" MinHeight="140" Background="{StaticResource WsPanelBackground}"
              BorderBrush="{StaticResource WsBorder}" BorderThickness="0,1,0,0" Padding="12,8" Height="230">
        <views:TimelineView x:Name="Timeline"/>
      </Border>
    </Grid>
  </DockPanel>
</Window>
